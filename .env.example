# Copy to .env.local and fill in. Never commit real secrets.

# Public URL of the site (used in emails, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — values from `npx supabase start` locally, or the project dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Signs links in emails and hashes rate-limit keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-32-random-characters-minimum

# Protects the scheduled-jobs endpoint (/api/cron/taches). 32+ random characters.
CRON_SECRET=change-me-to-32-random-characters-minimum

# E-mails. In production: RESEND_API_KEY + a sender on the verified domain.
# Locally, without a key, e-mails go to Mailpit (http://127.0.0.1:54324).
EMAIL_FROM="Lady A Beauty <rendez-vous@example.com>"
# EMAIL_REPLY_TO=contact@example.com
# RESEND_API_KEY=re_xxx
# EMAIL_TRANSPORT=resend   # resend | mailpit | log
